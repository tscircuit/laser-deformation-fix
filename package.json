{
  "name": "lightburn-lens-warp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Learn and apply geometric lens pre-warp corrections to LightBurn projects",
  "bin": {
    "lightburn-lens-warp": "./dist/cli.js"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "inspect": "bun run src/cli.ts inspect",
    "lightburn-lens-warp": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --target=node --outdir=dist",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "fast-xml-parser": "^5.3.2",
    "ml-matrix": "^6.12.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0"
  }
}
